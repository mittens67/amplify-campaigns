{
  "expo": {
    "name": "Amplify",
    "slug": "amplify-campaigns",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amplify",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.amplify.campaigns"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amplify.campaigns",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Amplify uses the microphone so you can describe your campaign out loud."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Amplify needs your photos to add images to your campaign."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0f6054b9-5b70-4985-a457-78348a39fad0"
      }
    },
    "owner": "mittens420"
  }
}
