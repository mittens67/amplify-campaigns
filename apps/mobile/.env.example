# Where the app finds the API. Leave unset on the same Wi-Fi with `npm run mobile`
# (the app then uses the PC's LAN address automatically).
#
# Needed with `npm run mobile:tunnel`, because Expo's tunnel only forwards the app bundle:
#   same Wi-Fi:        EXPO_PUBLIC_API_URL=http://192.168.31.133:4000
#   any network:       EXPO_PUBLIC_API_URL=https://<random>.trycloudflare.com   (cloudflared tunnel to port 4000)
#   deployed server:   EXPO_PUBLIC_API_URL=https://amplify-api-xxxx.onrender.com
EXPO_PUBLIC_API_URL=
