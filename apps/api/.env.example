# Leave DATABASE_URL empty to use an embedded local Postgres (PGlite) in ./.data
DATABASE_URL=
JWT_SECRET=change-me
PUBLIC_URL=http://localhost:4000
PORT=4000
# Optional: Supabase Storage for uploads (otherwise stored on local disk)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=campaign-media
# Optional: free Groq API key for voice transcription + AI drafting (otherwise demo mode)
GROQ_API_KEY=
