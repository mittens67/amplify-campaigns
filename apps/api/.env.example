# Leave DATABASE_URL empty to use an embedded local Postgres (PGlite) in ./.data
DATABASE_URL=
JWT_SECRET=change-me
PUBLIC_URL=http://localhost:4000
PORT=4000
# Optional: Supabase Storage for uploads (otherwise stored on local disk)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=campaign-media
# Optional AI (otherwise demo/template mode). Gemini preferred: one free key covers drafting + voice.
GEMINI_API_KEY=
# Or use Mistral instead:
MISTRAL_API_KEY=
